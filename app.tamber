tamber brand

axes
  dark-style = black | dim under scheme=dark

theme
  // Core Surfaces
  surface.page = light-dark(#ffffff, #000000)
    when dark-style=dim: light-dark(#ffffff, #15202b)
  surface.card = light-dark(#f1f3f5, #16181c)
    when dark-style=dim: light-dark(#f1f3f5, #1e2732)
  surface.grouped = light-dark(#f2f2f7, #1c1c1e)

  // Text & Labels
  text.primary = light-dark(#0f1419, #e7e9ea)
    when dark-style=dim: light-dark(#0f1419, #f7f9f9)
  text.secondary = light-dark(#5c6370, #9aa4b2)
  text.inverse = light-dark(#ffffff, #000000)

  // Brand & Accent Colors (indigo brand; status colours tuned for text on each surface)
  accent.primary = light-dark(#3b5bdb, #748ffc)
  accent.success = light-dark(#2b8a3e, #69db7c)
  accent.danger = light-dark(#c92a2a, #ff6b6b)
  accent.warning = light-dark(#b35c00, #ffa94d)

  // Components
  button.primary.bg = light-dark(#3b5bdb, #5c7cfa)
  button.primary.text = light-dark(#ffffff, #ffffff)
  button.secondary.bg = light-dark(#e9ecef, #2b3038)
  button.secondary.text = light-dark(#0f1419, #e7e9ea)

  // Borders & Separators
  border.default = light-dark(#c6c6c8, #38383a)
  separator = light-dark(#e5e5ea, #38383a)

  // Overlays
  overlay.scrim = light-dark(rgba(0,0,0,0.4), rgba(0,0,0,0.6))

  // Typography: simple sizes only (no composite font shorthand)
  font.size.body = 1rem
  font.size.heading = 1.5rem
  font.size.caption = 0.875rem
  font.weight.normal = 400
  font.weight.bold = 700

  // Spacing Scale (4px steps at the small end, 8px at the large)
  space.xxs = 2px
  space.xs = 4px
  space.sm = 8px
  space.md = 12px
  space.lg = 16px
  space.xl = 24px
  space.xxl = 32px

  // Border Radius
  radius.sm = 4px
  radius.md = 8px
  radius.lg = 16px
  radius.pill = 999px

  // Opacity
  opacity.disabled = 0.5
  opacity.muted = 0.7

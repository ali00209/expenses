shape Expense
  id: string
  title: string
  amount: number
  date: string

shape Change
  count: number

shape Summary
  total: number
  count: number

shape Time
  epochAtZero: number
  utcOffset: number

fn money(amount: number): string = amount >= 10000000 ? `PKR ${formatNumber(amount / 10000000, "decimal")} crore` : amount >= 100000 ? `PKR ${formatNumber(amount / 100000, "decimal")} lakh` : amount >= 1000 ? `PKR ${formatNumber(amount / 1000, "decimal")}k` : `PKR ${formatNumber(amount, "decimal")}`

routes nav
  home "/"
    add "/add"
    edit "/edit"

component Expenses
  state title = ""
  state amount = ""
  state date = ""
  state selected = []
  state editingId = ""
  state editTitle = ""
  state editAmount = ""
  state editDate = ""
  state toast = ""
  state toastUntil = 0
  state now = 0
  state filter = "all"
  state customStart = ""
  state customEnd = ""
  resource expenses = expenses() as shape Expense[]
  resource time = exactTime() as shape Time
  mutation changed as shape Change refreshes expenses, summary
  derive currentDate = formatDate(time.epochAtZero + now, time.utcOffset, "iso")
  derive filterStart = filter == "today" ? currentDate : filter == "week" ? formatDate(time.epochAtZero + now - 6 * 86400000, time.utcOffset, "iso") : filter == "month" ? `${currentDate.slice(0, 7)}-01` : filter == "custom" ? customStart : ""
  derive filterEnd = filter == "custom" ? customEnd : filter == "all" ? "" : currentDate
  derive visibleExpenses = expenses.filter((expense) => (filterStart == "" or expense.date >= filterStart) and (filterEnd == "" or expense.date <= filterEnd))
  derive allSelected = expenses.length > 0 and selected.length == expenses.length
  resource summary = expenseSummary(filterStart, filterEnd) as shape Summary

  task refreshDate mount
    every(60000, refreshDate)
  action refreshDate
    now = performanceNow()

  action setTitle(value: string)
    title = value
  action setAmount(value: string)
    amount = value
  action setDate(value: string)
    date = value
  action setFilter(value: string)
    filter = value
  action setCustomStart(value: string)
    customStart = value
  action setCustomEnd(value: string)
    customEnd = value
  action add
    if title.trim() != "" and amount.trim() != ""
      send changed = addExpense(title.trim(), amount.trim(), date == "" ? currentDate : date)
      title = ""
      amount = ""
      date = ""
      nav = back(nav)
  action toggleSelected(id: string, checked: bool)
    selected = checked ? selected.concat([id]) : selected.filter((item) => item != id)
  action selectAll
    selected = expenses.map((expense) => expense.id)
  action deselectAll
    selected = []
  action removeOne(id: string)
    send changed = removeExpenses([id])
    selected = selected.filter((item) => item != id)
    toast = "Expense deleted"
    toastUntil = performanceNow() + 5000
  action deleteSelected
    if selected.length > 0
      send changed = removeExpenses(selected)
      toast = `${selected.length} ${selected.length == 1 ? "expense" : "expenses"} deleted`
      toastUntil = performanceNow() + 5000
      selected = []
  action deleteAll
    if expenses.length > 0
      send changed = removeAll()
      toast = `${expenses.length} ${expenses.length == 1 ? "expense" : "expenses"} deleted`
      toastUntil = performanceNow() + 5000
      selected = []
  action undo
    send changed = undoDelete()
    toast = ""
    toastUntil = 0
  action clearToast
    toast = ""
    toastUntil = 0
  task hideToast when toast != "" key=toastUntil
    after(5000, clearToast)

  action beginEdit(id: string, value: string, valueAmount: string, valueDate: string)
    editingId = id
    editTitle = value
    editAmount = valueAmount
    editDate = valueDate
    nav = push(nav, "/edit")
  action openAdd
    title = ""
    amount = ""
    date = ""
    nav = push(nav, "/add")
  action closeForm
    nav = back(nav)
  action setEditTitle(value: string)
    editTitle = value
  action setEditAmount(value: string)
    editAmount = value
  action setEditDate(value: string)
    editDate = value
  action cancelEdit
    editingId = ""
  action saveEdit
    if editingId != "" and editTitle.trim() != "" and editAmount.trim() != ""
      send changed = updateExpense(editingId, editTitle.trim(), editAmount.trim(), editDate)
      editingId = ""
      nav = back(nav)

  view
    main id="app" navigationKey=`${top(nav).id}` navigationBack="closeForm" width="100%" height="100%" flex=1 min-height=0 testId="root"
      for e in stack(nav) key=e.id
        if e.name == "home"
          column navigationKey=`${e.id}` position="absolute" inset=0 width="100%" height="100%" flex=1 min-height=0
            list id="expenses" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
              section
                header
                  text "Expenses" role="heading" aria-level=1
                row
                  button popovertarget="filter-menu" aria-label="Filter expenses" testId="filter-button"
                    text "Filter"
                  button popovertarget="more-menu" aria-label="More options" testId="more"
                    text "More"
              section
                column padding=16 gap=8 background-color="-exact-secondary-background" border-radius=12 testId="summary"
                  row
                    column flex=1
                      text "Total expenses"
                      text money(summary.total) role="heading" aria-level=2 testId="total"
                    column
                      text "Expenses"
                      text `${summary.count}` role="heading" aria-level=2 testId="count"
              section
                for expense in visibleExpenses key=expense.id
                  row testId=`expense-${expense.id}` gap=8
                    input type="checkbox" checked=selected.includes(expense.id) change=toggleSelected(expense.id) aria-label=`Select ${expense.title}` testId=`select-${expense.id}`
                    column flex=1 min-width=0
                      text expense.title testId=`title-${expense.id}`
                      text `${money(expense.amount)} · ${expense.date}` testId=`details-${expense.id}`
                    button press=beginEdit(expense.id, expense.title, expense.amount.toString(), expense.date) testId=`edit-${expense.id}`
                      text "Edit"
                    button press=removeOne(expense.id) destructive=true testId=`remove-${expense.id}`
                      text "Delete"
            button press=openAdd aria-label="Add expense" buttonStyle="filled" position="absolute" right=20 bottom=20 testId="open-add"
              text "+"

            column id="more-menu" popover="auto" role="menu" aria-label="More options"
              if allSelected
                button press=deselectAll popovertarget="more-menu" popovertargetaction="hide" role="menuitem" testId="deselect-all"
                  text "Deselect all"
              else
                button press=selectAll popovertarget="more-menu" popovertargetaction="hide" role="menuitem" disabled=(expenses.length == 0) testId="select-all"
                  text "Select all"
              button press=deleteSelected popovertarget="more-menu" popovertargetaction="hide" role="menuitem" disabled=(selected.length == 0) testId="delete-selected"
                text "Delete selected"
              button press=deleteAll popovertarget="more-menu" popovertargetaction="hide" role="menuitem" disabled=(expenses.length == 0) testId="delete-all"
                text "Delete all"

            column id="filter-menu" popover="auto" role="menu" aria-label="Filter expenses"
              button press=setFilter("all") popovertarget="filter-menu" popovertargetaction="hide" role="menuitem" testId="filter-all"
                text "All dates"
              button press=setFilter("today") popovertarget="filter-menu" popovertargetaction="hide" role="menuitem" testId="filter-today"
                text "Today"
              button press=setFilter("week") popovertarget="filter-menu" popovertargetaction="hide" role="menuitem" testId="filter-week"
                text "This week"
              button press=setFilter("month") popovertarget="filter-menu" popovertargetaction="hide" role="menuitem" testId="filter-month"
                text "This month"
              button press=setFilter("custom") role="menuitem" testId="filter-custom"
                text "Custom range"
              if filter == "custom"
                row gap=8
                  input type="date" value=customStart change=setCustomStart aria-label="Filter start date" testId="filter-start"
                  input type="date" value=customEnd change=setCustomEnd aria-label="Filter end date" testId="filter-end"
        if e.name == "add"
          column navigationKey=`${e.id}` navigationPresentation="modal" navigationDetent="fit-content large" position="absolute" inset=0 background-color="-exact-background" padding=20 gap=12 testId="expense-form"
            header
              text "Add expense" role="heading" aria-level=2 flex=1
            input value=title input=setTitle maxlength=100 placeholder="Expense title" aria-label="Expense title" testId="title"
            input type="number" inputmode="decimal" value=amount input=setAmount min=0 step=0.01 placeholder="Amount" aria-label="Expense amount" testId="amount"
            input type="date" value=(date == "" ? currentDate : date) change=setDate aria-label="Expense date" testId="date"
            row gap=8
              button press=closeForm testId="cancel-add"
                text "Cancel"
              button press=add disabled=(title.trim() == "" or amount.trim() == "") buttonStyle="filled" testId="add"
                text "Add expense"
        if e.name == "edit"
          column navigationKey=`${e.id}` navigationPresentation="modal" navigationDetent="fit-content large" position="absolute" inset=0 background-color="-exact-background" padding=20 gap=12 testId="expense-form"
            header
              text "Edit expense" role="heading" aria-level=2 flex=1
            input value=editTitle input=setEditTitle maxlength=100 placeholder="Expense title" aria-label="Edit expense title" testId="edit-title"
            input type="number" inputmode="decimal" value=editAmount input=setEditAmount min=0 step=0.01 placeholder="Amount" aria-label="Edit expense amount" testId="edit-amount"
            input type="date" value=editDate change=setEditDate aria-label="Edit expense date" testId="edit-date"
            row gap=8
              button press=closeForm testId="cancel-edit"
                text "Cancel"
              button press=saveEdit disabled=(editTitle.trim() == "" or editAmount.trim() == "") buttonStyle="filled" testId="save-edit"
                text "Save"

      if toast != ""
        row id="toast" position="absolute" bottom=16 left=16 right=16 padding=12 gap=12 background-color="-exact-secondary-grouped-background" border-radius=8 testId="toast"
          text toast color="-exact-label" flex=1
          button press=undo testId="undo"
            text "Undo"

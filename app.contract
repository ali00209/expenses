use Bootstrap from "./lib/shapes.contract"
use Time from "./lib/shapes.contract"
use Group from "./lib/shapes.contract"
use GroupView from "./lib/shapes.contract"
use SyncStatus from "./lib/shapes.contract"
use SyncFeed from "./lib/shapes.contract"
use AuthReply from "./lib/shapes.contract"
use JoinReply from "./lib/shapes.contract"
use SaveReply from "./lib/shapes.contract"
use SyncReply from "./lib/shapes.contract"
use SessionReply from "./lib/shapes.contract"
use abs from "./lib/format.contract"
use money from "./lib/format.contract"
use expenseTitle from "./lib/format.contract"
use expenseAmount from "./lib/format.contract"
use expenseDate from "./lib/format.contract"
use expensePayer from "./lib/format.contract"
use expensePeople from "./lib/format.contract"
use amountValue from "./lib/format.contract"
use Toast from "./components/Toast.contract"
use AuthCard from "./components/AuthCard.contract"
use SyncBannerRows from "./components/SyncBannerRows.contract"
use GroupSummary from "./components/GroupSummary.contract"
use ExpenseRow from "./components/ExpenseRow.contract"
use BalanceRow from "./components/BalanceRow.contract"
use MemberRow from "./components/MemberRow.contract"
use ActivityRow from "./components/ActivityRow.contract"
use GroupsList from "./components/GroupsList.contract"
use ExpenseForm from "./components/ExpenseForm.contract"
use SettleContent from "./components/SettleContent.contract"
use SyncContent from "./components/SyncContent.contract"
use NewGroupFields from "./components/NewGroupFields.contract"
use JoinFields from "./components/JoinFields.contract"
use MemberFields from "./components/MemberFields.contract"
use AccountMenu from "./components/AccountMenu.contract"
use GroupMenu from "./components/GroupMenu.contract"

routes nav
  home "/"
    group "/group/:id"
    add "/group/:id/add"
    edit "/group/:id/expense/:expenseId"
    settle "/group/:id/settle"
    member "/group/:id/member"
    newGroup "/new"
    join "/join"
    sync "/sync"

component Tally
  // ============ STATE ============
  state now = 0
  state authMode = "signin"
  state email = ""
  state password = ""
  state authName = ""
  state authError = ""
  state groupName = ""
  state groupCurrency = "PKR"
  state groupTab = "expenses"
  state joinCode = ""
  state formDescription = ""
  state formAmount = ""
  state formDate = ""
  state formPayer = ""
  state formParticipants = []
  state editingId = ""
  state formError = ""
  state memberEmail = ""
  state memberName = ""
  state toast = ""
  state toastUntil = 0
  state syncEpoch = 0
  state lastReconnect = 0
  state lastSessionCheck = 0
  state lastUploadError = ""

  // ============ RESOURCES ============
  resource boot = bootstrap() as shape Bootstrap else empty()
  resource time = exactTime() as shape Time
  resource groups = groupList() as shape Group[] else empty()
  resource detail = groupView(groupId) as shape GroupView else empty()
  resource sync = syncStatus() as shape SyncStatus else empty()
  resource feed = syncStream(syncEpoch) as shape SyncFeed else empty()

  // ============ MUTATIONS ============
  mutation authDone as shape AuthReply refreshes boot, groups, sync then afterAuth
  mutation demoDone as shape AuthReply refreshes boot, groups, sync then afterDemo
  mutation groupMade as shape JoinReply refreshes boot, groups, sync then afterCreate
  mutation groupJoined as shape JoinReply refreshes boot, groups, sync then afterJoin
  mutation expenseSaved as shape SaveReply refreshes detail, groups, boot, sync then afterSave
  mutation expenseRemoved as shape SaveReply refreshes detail, groups, boot, sync then afterRemove
  mutation settled as shape SaveReply refreshes detail, groups, boot, sync then afterSettle
  mutation memberAdded as shape AuthReply refreshes detail, boot then afterMember
  mutation drained as shape SyncReply then afterDrain
  mutation uploaded as shape SyncReply then afterUpload
  mutation sessionChecked as shape SessionReply refreshes boot, sync then afterSession
  mutation discarded as shape SaveReply refreshes sync, boot then afterDiscard

  // ============ DERIVE ============
  derive current = top(nav)
  derive groupId = (current.name == "group" or current.name == "add" or current.name == "edit" or current.name == "settle" or current.name == "member") ? current.params.id : ""
  derive expenseId = current.name == "edit" ? current.params.expenseId : ""
  derive currentDate = formatDate(time.epochAtZero + now, time.utcOffset, "iso")
  derive nowMs = time.epochAtZero + now
  derive authErrorFromReply = match authDone { case some(r) => r.error, case none => "" }
  derive authOk = match authDone { case some(r) => r.ok, case none => false }
  derive demoError = match demoDone { case some(r) => r.error, case none => "" }
  derive demoOk = match demoDone { case some(r) => r.ok, case none => false }
  derive createdGroupId = match groupMade { case some(r) => r.groupId, case none => "" }
  derive createError = match groupMade { case some(r) => r.error, case none => "" }
  derive joinedGroupId = match groupJoined { case some(r) => r.groupId, case none => "" }
  derive joinError = match groupJoined { case some(r) => r.error, case none => "" }
  derive saveError = match expenseSaved { case some(r) => r.error, case none => "" }
  derive removeError = match expenseRemoved { case some(r) => r.error, case none => "" }
  derive settleError = match settled { case some(r) => r.error, case none => "" }
  derive memberError = match memberAdded { case some(r) => r.error, case none => "" }
  derive discardError = match discarded { case some(r) => r.error, case none => "" }
  derive drainApplied = match drained { case some(r) => r.applied, case none => 0 }
  derive drainState = match drained { case some(r) => r.state, case none => "" }
  derive drainError = match drained { case some(r) => r.error, case none => "" }
  derive uploadCount = match uploaded { case some(r) => r.uploaded, case none => 0 }
  derive uploadState = match uploaded { case some(r) => r.state, case none => "" }
  derive uploadError = match uploaded { case some(r) => r.error, case none => "" }
  derive sessionRefreshed = match sessionChecked { case some(r) => r.refreshed, case none => false }
  derive liveState = feed.state == "" ? sync.state : feed.state
  derive syncLabel = sync.demo ? "Demo · saved on this device" : liveState == "live" ? "Synced" : liveState == "syncing" ? "Syncing…" : liveState == "auth" ? "Sign in again to sync" : liveState == "offline" ? "Offline · saved on this device" : liveState == "error" ? "Sync needs attention" : "Saved on this device"
  derive splitCount = formParticipants.length
  derive splitPreview = splitCount > 0 and amountValue(formAmount) > 0 ? `${money(round(amountValue(formAmount) * 100 / splitCount), detail.currency)} each` : "Choose who shares it"
  derive canSaveExpense = formDescription.trim() != "" and formAmount.trim() != "" and formParticipants.length > 0 and not pending(expenseSaved)

  // ============ TASKS ============
  task clock mount
    every(15000, tick)
  task clockStart mount
    after(1, tick)
  task pump mount
    every(1200, drainNow)
  task upload mount
    every(6000, uploadNow)
  task watch mount
    every(4000, watchSync)
  task session mount
    every(60000, sessionTick)
  task sessionStart mount
    after(400, sessionTick)
  task hideToast when toast != "" key=toastUntil
    after(5000, clearToast)

  // ============ ACTIONS ============
  // (identical to the version in the previous message — unchanged)
  action tick
    now = performanceNow()
  action clearToast
    toast = ""
    toastUntil = 0
  action setEmail(v: string)
    email = v
  action setPassword(v: string)
    password = v
  action setAuthName(v: string)
    authName = v
  action toggleAuthMode
    authMode = authMode == "signin" ? "signup" : "signin"
    authError = ""
  action submitAuth
    if email.trim() != "" and password != "" and not pending(authDone)
      authError = ""
      send authDone = authenticate(authMode, email.trim(), password, authName.trim(), nowMs)
  action afterAuth
    syncEpoch = syncEpoch + 1
    authError = authErrorFromReply
    if authOk
      email = ""
      password = ""
      authName = ""
      nav = go(nav, "/")
  action startDemo
    if not pending(demoDone)
      send demoDone = startDemo(nowMs)
  action afterDemo
    syncEpoch = syncEpoch + 1
    authError = demoError
    if demoOk
      email = ""
      password = ""
      authName = ""
      nav = go(nav, "/")
  action exitDemo
    if not pending(demoDone)
      send demoDone = leaveDemo(nowMs)
  action signOut
    if not pending(authDone)
      send authDone = signOutSession()
  action setGroupName(v: string)
    groupName = v
  action setGroupCurrency(v: string)
    groupCurrency = v
  action setGroupTab(v: string)
    groupTab = v
  action openNewGroup
    groupName = ""
    groupCurrency = "PKR"
    nav = push(nav, path("newGroup"))
  action createGroupAction
    if groupName.trim() != "" and not pending(groupMade)
      send groupMade = createGroup(groupName.trim(), groupCurrency, nowMs)
  action afterCreate
    if createdGroupId != ""
      groupName = ""
      nav = go(nav, path("group", createdGroupId))
    else if createError != ""
      toast = createError
      toastUntil = performanceNow() + 5000
  action setJoinCode(v: string)
    joinCode = v
  action openJoin
    joinCode = ""
    nav = push(nav, path("join"))
  action joinGroupAction
    if joinCode.trim() != "" and not pending(groupJoined)
      send groupJoined = joinGroup(joinCode.trim().toUpperCase(), nowMs)
  action afterJoin
    if joinedGroupId != ""
      joinCode = ""
      syncEpoch = syncEpoch + 1
      nav = go(nav, path("group", joinedGroupId))
    else if joinError != ""
      toast = joinError
      toastUntil = performanceNow() + 5000
  action openGroup(id: string)
    nav = push(nav, path("group", id))
  action openAdd
    formDescription = ""
    formAmount = ""
    formDate = currentDate
    formPayer = boot.userId
    formParticipants = detail.members.map(m => m.id)
    editingId = ""
    formError = ""
    nav = push(nav, path("add", groupId))
  action openSettle
    nav = push(nav, path("settle", groupId))
  action openMember
    memberEmail = ""
    memberName = ""
    nav = push(nav, path("member", groupId))
  action goBack
    nav = back(nav)
  action follow(url: string)
    nav = go(nav, url)
  action setDescription(v: string)
    formDescription = v
  action setAmount(v: string)
    formAmount = v
  action setDate(v: string)
    formDate = v
  action setPayer(v: string)
    formPayer = v
  action toggleParticipant(id: string, checked: bool)
    formParticipants = checked ? formParticipants.concat([id]) : formParticipants.filter(x => x != id)
  action selectAllParticipants
    formParticipants = detail.members.map(m => m.id)
  action beginEdit(id: string)
    editingId = id
    formDescription = expenseTitle(detail.expenses, id)
    formAmount = expenseAmount(detail.expenses, id)
    formDate = expenseDate(detail.expenses, id)
    formPayer = expensePayer(detail.expenses, id)
    formParticipants = expensePeople(detail.expenses, id)
    formError = ""
    nav = push(nav, path("edit", groupId, id))
  action saveExpense
    if canSaveExpense
      send expenseSaved = saveExpense(groupId, editingId, formDescription.trim(), formAmount.trim(), formPayer, formParticipants, formDate == "" ? currentDate : formDate, nowMs)
  action afterSave
    formError = saveError
    if saveError == "" and not pending(expenseSaved)
      toast = editingId == "" ? "Expense added" : "Expense updated"
      toastUntil = performanceNow() + 4000
      editingId = ""
      nav = back(nav)
  action removeExpenseAction
    if editingId != "" and not pending(expenseRemoved)
      send expenseRemoved = deleteExpense(groupId, editingId, nowMs)
  action afterRemove
    if removeError != ""
      formError = removeError
    else if not pending(expenseRemoved)
      editingId = ""
      toast = "Expense deleted"
      toastUntil = performanceNow() + 4000
      nav = back(nav)
  action recordTransfer(fromId: string, toId: string, amount: number)
    if not pending(settled)
      send settled = recordSettlement(groupId, fromId, toId, amount, nowMs)
  action afterSettle
    if settleError != ""
      toast = settleError
      toastUntil = performanceNow() + 5000
    else if not pending(settled)
      toast = "Payment recorded"
      toastUntil = performanceNow() + 4000
  action setMemberEmail(v: string)
    memberEmail = v
  action setMemberName(v: string)
    memberName = v
  action addMemberAction
    if memberEmail.trim() != "" and not pending(memberAdded)
      send memberAdded = addGroupMember(groupId, memberEmail.trim(), memberName.trim(), nowMs)
  action afterMember
    if memberError != ""
      toast = memberError
      toastUntil = performanceNow() + 5000
    else if not pending(memberAdded)
      memberEmail = ""
      memberName = ""
      toast = "Member added"
      toastUntil = performanceNow() + 4000
  action refreshAll
    refresh detail
    refresh groups
    refresh boot
    refresh sync
  action syncNow
    syncEpoch = syncEpoch + 1
    refresh sync
    if boot.signedIn and not boot.demo and not pending(uploaded)
      send uploaded = uploadPending(nowMs)
  action discardFailed
    if not pending(discarded)
      send discarded = discardFailed()
  action afterDiscard
    if discardError != ""
      toast = discardError
      toastUntil = performanceNow() + 5000
  action afterSession
    if sessionRefreshed
      syncEpoch = syncEpoch + 1
  action drainNow
    if boot.signedIn and not boot.demo and not pending(drained)
      send drained = drainSync(nowMs)
  action afterDrain
    if drainApplied > 0
      refresh detail
      refresh groups
      refresh boot
      refresh sync
    if drainState == "auth" and not pending(sessionChecked)
      lastSessionCheck = now
      send sessionChecked = ensureSession(nowMs)
    if drainState == "offline" and now - lastReconnect > 15000
      lastReconnect = now
      syncEpoch = syncEpoch + 1
  action uploadNow
    if boot.signedIn and not boot.demo and not pending(uploaded)
      send uploaded = uploadPending(nowMs)
  action afterUpload
    lastUploadError = uploadError
    if uploadCount > 0
      refresh detail
      refresh groups
      refresh boot
      refresh sync
    if uploadState == "auth" and not pending(sessionChecked)
      lastSessionCheck = now
      send sessionChecked = ensureSession(nowMs)
  action watchSync
    if boot.signedIn and not boot.demo
      refresh sync
  action sessionTick
    if boot.signedIn and not boot.demo and not pending(sessionChecked) and now - lastSessionCheck > 55000
      lastSessionCheck = now
      send sessionChecked = ensureSession(nowMs)

  // ============ VIEW ============
  view
    main navigationKey=`${top(nav).id}`
      navigationBack="goBack"
      navigate=follow
      width="100%"
      height="100%"
      flex=1
      min-height=0
      testId="root"
      for e in stack(nav) key=e.id
        if e.name == "home"
          column navigationKey=`${e.id}`
            navigationScroll=(boot.signedIn or boot.demo ? "groups" : "home-scroll")
            position="absolute"
            inset=0
            display="flex"
            flex-direction="column"
            header display="flex" align-items="center" gap="space.sm"
              text "Tally" role="heading" aria-level=1 flex=1
              button popovertarget="account-menu" aria-label="Account" testId="account"
                image "symbol:person"
            if not current(boot)
              column flex=1 justify-content="center" align-items="center"
                progress aria-label="Loading"
            else if not boot.signedIn and not boot.demo
              scroll id="home-scroll" flex=1 min-height=0
                column padding="space.xl" gap="space.lg" align-items="center"
                  column gap="space.xs" align-items="center"
                    text "Welcome" role="heading" aria-level=2 font="-exact-large-title"
                    text "Split expenses with friends. Every change is saved on this device first." text-align="center"
                      color="text.secondary"
                  AuthCard(
                    mode=authMode,
                    email=email,
                    password=password,
                    name=authName,
                    error=authError,
                    busy=pending(authDone),
                    onEmail=setEmail,
                    onPassword=setPassword,
                    onName=setAuthName,
                    onSubmit=submitAuth,
                    onToggleMode=toggleAuthMode
                  )
                  button press=startDemo
                    buttonStyle="bordered"
                    disabled=pending(demoDone)
                    testId="demo"
                    text "Try the demo"
                  text "The demo works offline. Sign in to sync with your friends." font="-exact-footnote"
                    color="text.secondary"
                    text-align="center"
            else
              list id="groups" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                section
                  SyncBannerRows(
                    liveState=liveState,
                    syncLabel=syncLabel,
                    pending=sync.pending,
                    failed=sync.failed,
                    error=sync.error,
                    canSync=(boot.signedIn and not boot.demo),
                    onSync=syncNow
                  )
                GroupsList(groups=groups, onNew=openNewGroup, onJoin=openJoin)

        if e.name == "group"
          column navigationKey=`${e.id}`
            navigationScroll=`group-scroll-${e.id}`
            position="absolute"
            inset=0
            display="flex"
            flex-direction="column"
            header display="flex" align-items="center" gap="space.sm"
              text (detail.name == "" ? "Group" : detail.name) role="heading"
                aria-level=2
                flex=1
                testId="group-title"
              button press=openAdd aria-label="Add expense" testId="add-expense"
                image "symbol:add"
              button popovertarget="group-menu" aria-label="Group options" testId="group-menu"
                image "symbol:more"
            if detail.id == ""
              column flex=1 justify-content="center" align-items="center" gap="space.sm"
                if pending(detail)
                  progress aria-label="Loading group"
                else
                  text "This group isn't on this device yet." color="text.secondary"
                    text-align="center"
                  text "It will appear when sync finishes." font="-exact-footnote"
                    color="text.secondary"
                    text-align="center"
            else
              list id=`group-scroll-${e.id}`
                appearance="auto"
                listStyle="inset-grouped"
                flex=1
                min-height=0
                section
                  GroupSummary(
                    detail=detail,
                    canSettle=(detail.transfers.length > 0),
                    onSettle=openSettle,
                    onAdd=openAdd
                  )
                section
                  row role="radiogroup" aria-label="Group sections" gap="space.xs"
                    button role="radio" aria-checked=(groupTab == "expenses") press=setGroupTab("expenses") testId="tab-expenses"
                      text "Expenses"
                    button role="radio" aria-checked=(groupTab == "balances") press=setGroupTab("balances") testId="tab-balances"
                      text "Balances"
                    button role="radio" aria-checked=(groupTab == "members") press=setGroupTab("members") testId="tab-members"
                      text "Members"
                    button role="radio" aria-checked=(groupTab == "activity") press=setGroupTab("activity") testId="tab-activity"
                      text "Activity"
                if groupTab == "expenses"
                  section
                    header
                      text "Expenses"
                    if detail.expenses.length == 0
                      row
                        column gap="space.xs"
                          text "No expenses yet"
                          text "Add the first one to start the ledger." font="-exact-footnote"
                            color="text.secondary"
                    for x, i in detail.expenses key=x.id
                      ExpenseRow(expense=x, isFirst=(i == 0), onEdit=beginEdit(x.id))
                if groupTab == "balances"
                  section
                    header
                      text "Balances"
                    if detail.balances.length == 0
                      row
                        text "Everyone is settled up."
                    for b in detail.balances key=b.id
                      BalanceRow(balance=b, currency=detail.currency)
                if groupTab == "members"
                  section
                    header
                      text "Members"
                    for m in detail.members key=m.id
                      MemberRow(member=m)
                if groupTab == "activity"
                  section
                    header
                      text "Activity"
                    if detail.activity.length == 0
                      row
                        text "Nothing has happened yet." color="text.secondary"
                    for a in detail.activity key=a.id
                      ActivityRow(activity=a)

        if e.name == "add"
          column navigationKey=`${e.id}`
            navigationPresentation="modal"
            navigationDetent="fit-content large"
            navigationScroll=`add-scroll-${e.id}`
            position="absolute"
            inset=0
            background-color="surface.page"
            testId="expense-form"
            header display="flex" align-items="center" gap="space.sm"
              button press=goBack testId="cancel-expense"
                text "Cancel"
              text "Add expense" role="heading" aria-level=2 flex=1
              button press=saveExpense
                buttonStyle="bordered-prominent"
                disabled=(not canSaveExpense)
                testId="save-expense"
                text "Save"
            scroll id=`add-scroll-${e.id}` flex=1 min-height=0
              ExpenseForm(
                currency=detail.currency,
                currentDate=currentDate,
                members=detail.members,
                description=formDescription,
                amount=formAmount,
                date=formDate,
                payer=formPayer,
                participants=formParticipants,
                error=formError,
                preview=splitPreview,
                showDelete=false,
                onDescription=setDescription,
                onAmount=setAmount,
                onDate=setDate,
                onPayer=setPayer,
                onToggleParticipant=toggleParticipant,
                onSelectAll=selectAllParticipants,
                onDelete=removeExpenseAction
              )

        if e.name == "edit"
          column navigationKey=`${e.id}`
            navigationPresentation="modal"
            navigationDetent="fit-content large"
            navigationScroll=`edit-scroll-${e.id}`
            position="absolute"
            inset=0
            background-color="surface.page"
            testId="expense-form"
            header display="flex" align-items="center" gap="space.sm"
              button press=goBack testId="cancel-expense"
                text "Cancel"
              text "Edit expense" role="heading" aria-level=2 flex=1
              button press=saveExpense
                buttonStyle="bordered-prominent"
                disabled=(not canSaveExpense)
                testId="save-expense"
                text "Save"
            scroll id=`edit-scroll-${e.id}` flex=1 min-height=0
              ExpenseForm(
                currency=detail.currency,
                currentDate=currentDate,
                members=detail.members,
                description=formDescription,
                amount=formAmount,
                date=formDate,
                payer=formPayer,
                participants=formParticipants,
                error=formError,
                preview=splitPreview,
                showDelete=true,
                onDescription=setDescription,
                onAmount=setAmount,
                onDate=setDate,
                onPayer=setPayer,
                onToggleParticipant=toggleParticipant,
                onSelectAll=selectAllParticipants,
                onDelete=removeExpenseAction
              )

        if e.name == "settle"
          column navigationKey=`${e.id}`
            navigationPresentation="modal"
            navigationDetent="fit-content large"
            position="absolute"
            inset=0
            background-color="surface.page"
            testId="settle-sheet"
            header display="flex" align-items="center" gap="space.sm"
              button press=goBack testId="close-settle"
                text "Done"
              text "Settle up" role="heading" aria-level=2 flex=1
            list id=`settle-list-${e.id}`
              appearance="auto"
              listStyle="inset-grouped"
              flex=1
              min-height=0
              SettleContent(detail=detail, userId=boot.userId, onPay=recordTransfer)

        if e.name == "newGroup"
          column navigationKey=`${e.id}`
            navigationPresentation="modal"
            navigationDetent="fit-content large"
            navigationScroll=`new-group-scroll-${e.id}`
            position="absolute"
            inset=0
            background-color="surface.page"
            testId="new-group-form"
            header display="flex" align-items="center" gap="space.sm"
              button press=goBack testId="cancel-new-group"
                text "Cancel"
              text "New group" role="heading" aria-level=2 flex=1
              button press=createGroupAction
                buttonStyle="bordered-prominent"
                disabled=(groupName.trim() == "" or pending(groupMade))
                testId="create-group"
                text "Create"
            scroll id=`new-group-scroll-${e.id}` flex=1 min-height=0
              NewGroupFields(
                name=groupName,
                currency=groupCurrency,
                onName=setGroupName,
                onCurrency=setGroupCurrency
              )

        if e.name == "join"
          column navigationKey=`${e.id}`
            navigationPresentation="modal"
            navigationDetent="fit-content large"
            navigationScroll=`join-scroll-${e.id}`
            position="absolute"
            inset=0
            background-color="surface.page"
            testId="join-form"
            header display="flex" align-items="center" gap="space.sm"
              button press=goBack testId="cancel-join"
                text "Cancel"
              text "Join a group" role="heading" aria-level=2 flex=1
              button press=joinGroupAction
                buttonStyle="bordered-prominent"
                disabled=(joinCode.trim() == "" or pending(groupJoined))
                testId="join"
                text "Join"
            scroll id=`join-scroll-${e.id}` flex=1 min-height=0
              JoinFields(code=joinCode, onCode=setJoinCode)

        if e.name == "member"
          column navigationKey=`${e.id}`
            navigationPresentation="modal"
            navigationDetent="fit-content large"
            navigationScroll=`member-scroll-${e.id}`
            position="absolute"
            inset=0
            background-color="surface.page"
            testId="member-form"
            header display="flex" align-items="center" gap="space.sm"
              button press=goBack testId="cancel-member"
                text "Cancel"
              text "Add member" role="heading" aria-level=2 flex=1
              button press=addMemberAction
                buttonStyle="bordered-prominent"
                disabled=(memberEmail.trim() == "" or pending(memberAdded))
                testId="add-member"
                text "Add"
            scroll id=`member-scroll-${e.id}` flex=1 min-height=0
              MemberFields(
                email=memberEmail,
                name=memberName,
                onEmail=setMemberEmail,
                onName=setMemberName
              )

        if e.name == "sync"
          column navigationKey=`${e.id}`
            navigationPresentation="modal"
            navigationDetent="fit-content large"
            position="absolute"
            inset=0
            background-color="surface.page"
            testId="sync-sheet"
            header display="flex" align-items="center" gap="space.sm"
              button press=goBack testId="close-sync"
                text "Done"
              text "Sync" role="heading" aria-level=2 flex=1
            list id=`sync-list-${e.id}`
              appearance="auto"
              listStyle="inset-grouped"
              flex=1
              min-height=0
              SyncContent(
                sync=sync,
                syncLabel=syncLabel,
                liveState=liveState,
                canSync=(boot.signedIn and not boot.demo),
                hasFailed=(sync.failed > 0),
                onSync=syncNow,
                onDiscard=discardFailed
              )

      AccountMenu(
        boot=boot,
        onLeaveDemo=exitDemo,
        onSync=syncNow,
        onSignOut=signOut,
        onSignIn=toggleAuthMode
      )
      GroupMenu(
        detail=detail,
        boot=boot,
        onRefresh=refreshAll,
        onAddMember=openMember,
        onLeaveDemo=exitDemo
      )
      if toast != ""
        Toast(message=toast, onDismiss=clearToast)

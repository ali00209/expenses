component Toast
  props
    message: string
    onDismiss: action
  view
    row id="toast"
      position="absolute"
      bottom=16
      left=16
      right=16
      padding="space.md"
      gap="space.md"
      background-color="surface.grouped"
      border-radius="radius.md"
      testId="toast"
      text message color="text.primary" flex=1
      button press=onDismiss testId="dismiss-toast"
        text "Dismiss"

test "add, edit, select, delete and undo expenses"
  expect tree has "root"
  tap "open-add"
  clock settle
  type "title" "Coffee"
  type "amount" "250"
  type "date" "2026-11-11"
  tap "add"
  clock settle
  tap "open-add"
  clock settle
  type "title" "Train ticket"
  type "amount" "120"
  type "date" "2026-11-10"
  tap "add"
  clock settle
  expect tree has "expense-1"
  expect tree has "expense-2"
  expect text "total" == "PKR 370"
  expect text "count" == "2"
  expect text "title-1" == "Coffee"
  expect text "details-1" == "PKR 250 · 2026-11-11"
  tap "edit-1"
  clock settle
  type "edit-title" "Coffee and tea"
  type "edit-amount" "300"
  tap "save-edit"
  clock settle
  expect text "title-1" == "Coffee and tea"
  expect text "details-1" == "PKR 300 · 2026-11-11"
  tap "select-1"
  tap "more"
  tap "delete-selected"
  expect tree missing "expense-1"
  expect tree has "toast"
  tap "undo"
  expect tree has "expense-1"
  tap "remove-1"
  expect tree missing "expense-1"
  expect tree has "expense-2"
  tap "filter"
  type "filter" "custom"
  type "filter-start" "2026-11-11"
  type "filter-end" "2026-11-11"
  expect tree missing "expense-2"

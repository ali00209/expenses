test "add and delete expenses"
  expect tree has "root"
  type "new-expense" "Coffee"
  tap "add"
  type "new-expense" "Train ticket"
  type "new-expense" key "Enter"
  expect tree has "expense-1"
  expect tree has "expense-2"
  expect text "description-1" == "Coffee"
  tap "remove-1"
  expect tree missing "expense-1"
  expect tree has "expense-2"
